  "private": true,
  "description": "Praxis hot-path hooks for Claude Code. Runtime: Node built-ins only (Rule A7).",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
